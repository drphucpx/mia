<body class="pb-12 select-none all-in-one-active">

  <!-- Confetti Canvas Overlay -->
  <canvas id="confettiCanvas" class="fixed inset-0 pointer-events-none z-50"></canvas>

  <!-- Toast Notification -->
  <div id="toastBanner" class="fixed top-4 right-4 z-50 hidden max-w-sm bg-white border-4 border-amber-400 rounded-2xl px-4 py-3 shadow-2xl flex items-center gap-3 animate-pop">
    <span id="toastIcon" class="text-3xl">🌟</span>
    <div>
      <p id="toastTitle" class="font-bold text-slate-900 text-base leading-tight">Tuyệt vời quá Mía ơi!</p>
      <p id="toastMsg" class="text-xs font-extrabold text-blue-600 mt-0.5">+10 Sao Thông Thái</p>
    </div>
  </div>

  <!-- Live Speaking Indicator Pill -->
  <div id="speakingIndicator" class="fixed bottom-4 right-4 z-40 hidden bg-slate-900/90 text-white border-2 border-cyan-400 rounded-2xl px-3.5 py-2 shadow-xl flex items-center gap-2.5">
    <div class="flex items-center gap-1 h-4">
      <span class="w-1 h-4 bg-cyan-400 rounded-full wave-bar"></span>
      <span class="w-1 h-4 bg-amber-400 rounded-full wave-bar" style="animation-delay: 0.15s"></span>
      <span class="w-1 h-4 bg-emerald-400 rounded-full wave-bar" style="animation-delay: 0.3s"></span>
    </div>
    <span id="speakingWordLabel" class="text-xs font-extrabold text-cyan-200">🔊 Đang đọc...</span>
  </div>

  <!-- Top Header / Mia's Royal Profile (Boy Theme) -->
  <header class="bg-gradient-to-r from-slate-900 via-blue-800 to-indigo-900 text-white shadow-xl sticky top-0 z-30 border-b-4 border-amber-400">
    <div class="max-w-6xl mx-auto px-3 sm:px-6 py-2.5 flex flex-wrap items-center justify-between gap-2">
      <!-- Mascot & Title -->
      <div class="flex items-center gap-3">
        <div class="relative">
          <img src="data:image/jpeg;base64," alt="Hoàng tử cờ vua Mía" class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl object-cover border-2 border-amber-400 shadow-md max-w-full h-auto">
          <span class="absolute -top-2 -left-2 text-lg drop-shadow">👑</span>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-lg sm:text-xl md:text-2xl font-bold tracking-wide text-white drop-shadow-sm">
              Vương Quốc Cờ Vua Của Mía
            </h1>
            <span class="hidden sm:inline-block bg-amber-400 text-slate-950 text-xs font-extrabold px-2.5 py-0.5 rounded-full shadow-sm">
              Boy Lớp 2 ⚡
            </span>
          </div>
          <p id="miaRankLabel" class="text-xs sm:text-sm text-cyan-200 font-semibold flex items-center gap-1">
            <span>🛡️ Danh hiệu:</span>
            <span id="rankNameText" class="text-amber-300 font-extrabold underline decoration-dotted">⚔️ Tân Binh Cờ Vua</span>
          </p>
        </div>
      </div>

      <!-- Stats & Controls -->
      <div class="flex items-center flex-wrap gap-2">
        <!-- Stars -->
        <div class="bg-white/15 backdrop-blur-sm border border-cyan-300/30 rounded-xl px-3 py-1.5 flex items-center gap-1.5" title="Sao Thông Thái của Mía">
          <span class="text-xl">⭐</span>
          <div>
            <div class="text-[10px] uppercase tracking-wider text-cyan-200 font-bold leading-none">Sao của Mía</div>
            <div id="starCountText" class="text-base sm:text-lg font-extrabold text-amber-300 leading-tight">15</div>
          </div>
        </div>

        <!-- Streak & Multiplier -->
        <div class="bg-white/15 backdrop-blur-sm border border-cyan-300/30 rounded-xl px-3 py-1.5 flex items-center gap-1.5" title="Chuỗi trả lời đúng liên tiếp">
          <span class="text-xl">🔥</span>
          <div>
            <div class="text-[10px] uppercase tracking-wider text-cyan-200 font-bold leading-none">Combo đúng</div>
            <div class="flex items-center gap-1">
              <span id="streakCountText" class="text-base sm:text-lg font-extrabold text-orange-300 leading-tight">0</span>
              <span id="comboMultiplierPill" class="hidden bg-amber-400 text-slate-950 text-[10px] font-black px-1.5 py-0.2 rounded">x2</span>
            </div>
          </div>
        </div>

        <!-- Badges Modal Button -->
        <button id="openBadgesBtn" type="button" class="btn-candy bg-amber-400 hover:bg-amber-300 text-slate-950 font-extrabold text-xs sm:text-sm px-3 py-2 rounded-xl flex items-center gap-1.5">
          <span>🏆</span>
          <span class="hidden md:inline">Huy hiệu</span>
          <span id="badgeCountPill" class="bg-slate-900 text-amber-300 text-xs px-1.5 py-0.2 rounded-full">1/6</span>
        </button>

        <!-- Speech Rate Toggle -->
        <button id="toggleSpeedBtn" type="button" class="btn-candy bg-blue-700 hover:bg-blue-600 text-white font-bold text-xs sm:text-sm px-2.5 py-2 rounded-xl flex items-center gap-1" title="Chỉnh tốc độ đọc tiếng Anh">
          <span id="speedIcon">🐢</span>
          <span id="speedText" class="hidden sm:inline">Đọc chậm</span>
        </button>

        <!-- Sound Mute Toggle -->
        <button id="toggleMuteBtn" type="button" class="btn-candy bg-blue-700 hover:bg-blue-600 text-white font-bold text-xs sm:text-sm px-2.5 py-2 rounded-xl flex items-center gap-1" title="Bật/Tắt âm thanh">
          <span id="muteIcon">🔊</span>
        </button>
      </div>
    </div>

    <!-- Navigation Bar -->
    <div class="bg-slate-950/50 backdrop-blur-sm border-t border-white/10">
      <div class="max-w-6xl mx-auto px-2 sm:px-6 py-2 flex items-center justify-between gap-1.5 overflow-x-auto">
        <div class="flex items-center gap-1.5 sm:gap-2 w-full sm:w-auto justify-around sm:justify-start">
          <button type="button" data-tab="learn" class="nav-tab-btn btn-candy bg-amber-400 text-slate-950 font-extrabold text-xs sm:text-sm px-3 sm:px-4 py-2 rounded-xl flex items-center gap-1.5 shrink-0">
            <span>📖</span>
            <span>1. Học Từ &amp; Bàn Cờ</span>
          </button>
          <button type="button" data-tab="board" class="nav-tab-btn btn-candy bg-blue-800/80 hover:bg-blue-700 text-white font-bold text-xs sm:text-sm px-3 sm:px-4 py-2 rounded-xl flex items-center gap-1.5 shrink-0">
            <span>🦄</span>
            <span>2. Phiêu Lưu Bàn Cờ</span>
          </button>
          <button type="button" data-tab="quiz" class="nav-tab-btn btn-candy bg-blue-800/80 hover:bg-blue-700 text-white font-bold text-xs sm:text-sm px-3 sm:px-4 py-2 rounded-xl flex items-center gap-1.5 shrink-0">
            <span>🎧</span>
            <span>3. Đố Vui &amp; Đánh Vần</span>
          </button>
          <button type="button" data-tab="memory" class="nav-tab-btn btn-candy bg-blue-800/80 hover:bg-blue-700 text-white font-bold text-xs sm:text-sm px-3 sm:px-4 py-2 rounded-xl flex items-center gap-1.5 shrink-0">
            <span>🧩</span>
            <span>4. Lật Thẻ Trí Nhớ</span>
          </button>
        </div>

        <!-- Mastered Progress Pill -->
        <div class="hidden lg:flex items-center gap-2 bg-slate-900/80 px-3 py-1.5 rounded-xl border border-cyan-400/30 shrink-0">
          <span class="text-xs font-bold text-cyan-200">Từ Mía đã thuộc:</span>
          <div class="w-24 h-2.5 bg-slate-950 rounded-full overflow-hidden">
            <div id="masteredProgressBar" class="h-full bg-gradient-to-r from-amber-400 to-emerald-400 transition-all duration-300" style="width: 6%;"></div>
          </div>
          <span id="masteredCountText" class="text-xs font-extrabold text-amber-300">1/16</span>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Content Container -->
  <main class="max-w-6xl mx-auto px-3 sm:px-6 pt-5">

    <!-- Welcome Hero Banner for Boy Mia -->
    <section class="mb-5 bg-white/95 backdrop-blur rounded-3xl p-4 sm:p-5 border-2 border-blue-200 chess-card-shadow flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3.5">
        <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-gradient-to-br from-blue-600 to-indigo-800 p-1 shrink-0 shadow-md animate-float">
          <img src="data:image/jpeg;base64," alt="Kiện tướng nhí Mía" class="w-full h-full object-cover rounded-xl max-w-full h-auto">
        </div>
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <h2 id="greetingBannerTitle" class="text-lg sm:text-xl font-bold text-slate-900">
              Chào Hoàng Tử Cờ Vua Mía (Lớp 2)! ⚔️👑
            </h2>
            <span class="text-[11px] font-extrabold bg-blue-100 text-blue-800 px-2.5 py-0.5 rounded-full">
              ⌨️ Mẹo: Bấm phím Space để nghe, phím ⬅️➡️ để chuyển từ!
            </span>
          </div>
          <p id="greetingBannerSub" class="text-xs sm:text-sm text-slate-600 font-semibold mt-0.5">
            Cùng Mía chinh phục 16 tuyệt chiêu tiếng Anh môn Cờ Vua, điều khiển quân cờ chiến đấu và săn huy hiệu Quốc Vương nhé!
          </p>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <button id="toggleAllInOneViewBtn" type="button" class="btn-candy bg-emerald-500 hover:bg-emerald-400 text-white font-extrabold text-xs sm:text-sm px-3.5 py-2.5 rounded-2xl flex items-center gap-1.5" title="Hiển thị toàn bộ 4 phần chơi liền mạch trên 1 trang duy nhất">
          <span>📜</span>
          <span id="allInOneViewLabel">Chế độ: Tất cả trên 1 trang ✅</span>
        </button>
        <button id="downloadSingleHtmlBtn" type="button" class="btn-candy bg-amber-400 hover:bg-amber-300 text-slate-950 font-extrabold text-xs sm:text-sm px-3.5 py-2.5 rounded-2xl flex items-center gap-1.5" title="Lưu toàn bộ game thành 1 file .html duy nhất để chơi offline">
          <span>💾</span>
          <span>Tải 1 File HTML</span>
        </button>
        <button id="speakWelcomeBtn" type="button" class="btn-candy bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-extrabold text-xs sm:text-sm px-3.5 py-2.5 rounded-2xl flex items-center gap-1.5">
          <span>🔊</span>
          <span>Chào Mía bằng Tiếng Anh!</span>
        </button>
      </div>
    </section>

    <!-- ========================================================= -->
    <!-- TAB 1: HỌC TỪ VỰNG & BÀN CỜ TƯƠNG TÁC (FLASHCARDS + BOARD) -->
    <!-- ========================================================= -->
    <section id="tab-learn" class="tab-panel space-y-5">
      <!-- Category Filter Bar -->
      <div class="flex flex-wrap items-center justify-between gap-2 bg-white/90 p-3 rounded-2xl border border-blue-200 shadow-sm">
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="text-xs sm:text-sm font-extrabold text-slate-800 mr-1">📂 Nhóm từ:</span>
          <button type="button" data-cat="all" class="cat-filter-btn btn-candy bg-blue-600 text-white font-extrabold text-xs sm:text-sm px-3 py-1.5 rounded-xl">
            Tất cả (16)
          </button>
          <button type="button" data-cat="pieces" class="cat-filter-btn btn-candy bg-blue-50 hover:bg-blue-100 text-slate-800 font-bold text-xs sm:text-sm px-3 py-1.5 rounded-xl">
            ♟️ Quân Cờ (6)
          </button>
          <button type="button" data-cat="board" class="cat-filter-btn btn-candy bg-blue-50 hover:bg-blue-100 text-slate-800 font-bold text-xs sm:text-sm px-3 py-1.5 rounded-xl">
            🏁 Bàn Cờ (5)
          </button>
          <button type="button" data-cat="actions" class="cat-filter-btn btn-candy bg-blue-50 hover:bg-blue-100 text-slate-800 font-bold text-xs sm:text-sm px-3 py-1.5 rounded-xl">
            ⚡ Nước Đi &amp; Hiệu Lệnh (5)
          </button>
        </div>

        <div class="flex items-center gap-2">
          <button id="randomWordBtn" type="button" class="btn-candy bg-amber-400 hover:bg-amber-300 text-slate-950 font-extrabold text-xs sm:text-sm px-3 py-1.5 rounded-xl flex items-center gap-1">
            <span>🎲</span>
            <span>Từ ngẫu nhiên</span>
          </button>
        </div>
      </div>

      <!-- Main Flashcard + Interactive Mini Board Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-stretch">

        <!-- Left Column: Big Interactive Flashcard (7 cols) -->
        <div class="lg:col-span-7 bg-white rounded-3xl p-5 sm:p-6 border-4 border-blue-200 chess-card-shadow flex flex-col justify-between relative overflow-hidden">
          <!-- Top Card Header -->
          <div class="flex items-center justify-between gap-2 z-10">
            <span id="cardCategoryBadge" class="bg-blue-100 text-blue-900 text-xs font-extrabold px-3 py-1 rounded-full">♟️ Quân Cờ</span>
            <div class="flex items-center gap-2">
              <span id="cardIndexText" class="text-xs font-bold text-slate-500">Từ số 1 / 16</span>
              <button id="toggleMasteredBtn" type="button" class="btn-candy bg-emerald-500 text-white font-extrabold text-xs px-3 py-1.5 rounded-xl flex items-center gap-1">
                <span id="masteredIcon">✅</span>
                <span id="masteredBtnLabel">Mía đã thuộc từ này!</span>
              </button>
            </div>
          </div>

          <!-- Center Word Showcase -->
          <div class="my-4 flex flex-col sm:flex-row items-center gap-5 bg-gradient-to-br from-blue-50 via-indigo-50 to-amber-50 rounded-2xl p-4 sm:p-5 border-2 border-blue-100">
            <!-- Big Animated Piece Icon Box -->
            <div id="cardArtContainer" class="w-28 h-28 sm:w-32 sm:h-32 rounded-3xl bg-white border-4 border-amber-400 shadow-md flex flex-col items-center justify-center shrink-0 cursor-pointer group hover:scale-105 transition-transform" title="Bấm để nghe phát âm!">
              <div id="cardEmojiBig" class="text-6xl sm:text-7xl select-none group-hover:scale-110 transition-transform">♔</div>
              <span class="text-[11px] font-extrabold text-blue-600 mt-1">Bấm nghe 🔊</span>
            </div>

            <!-- Word, Phonetic, Meaning -->
