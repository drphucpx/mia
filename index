        for (let i = 0; i < 18; i++) {
          state.canvasParticles.push({
            r: gridR + 0.5,
            c: gridC + 0.5,
            vr: (Math.random() - 0.5) * 0.14,
            vc: (Math.random() - 0.5) * 0.14,
