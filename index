      // Spelling Bee Logic
      function startNewSpellingWord() {
        const target = CHESS_WORDS[Math.floor(Math.random() * CHESS_WORDS.length)];
        state.spellCurrentWord = target;
        state.spellChosenIndices = [];

        const letters = target.word.split('').map(function (ch, idx) {
          return { ch: ch, origIdx: idx };
        });
        letters.sort(function () { return Math.random() - 0.5; });
        state.spellShuffledLetters = letters;

        document.getElementById('spellEmoji').textContent = target.emoji;
        document.getElementById('spellMeaningVi').textContent = target.vi;
        document.getElementById('spellSentenceClue').textContent = '"' + target.exampleEn + '"';
        document.getElementById('spellFeedbackBox').textContent = '👆 Mía hãy bấm chữ cái hoặc gõ phím A-Z trên bàn phím nhé!';

        renderSpellingUI();
      }

      function renderSpellingUI() {
        const target = state.spellCurrentWord;
        if (!target) return;

        const slotsContainer = document.getElementById('spellAnswerSlots');
        const bankContainer = document.getElementById('spellLetterBank');
        slotsContainer.innerHTML = '';
        bankContainer.innerHTML = '';

        for (let i = 0; i < target.word.length; i++) {
          const chosenBankIdx = state.spellChosenIndices[i];
          const slotBtn = document.createElement('button');
          slotBtn.type = 'button';

          if (typeof chosenBankIdx === 'number') {
            const letterObj = state.spellShuffledLetters[chosenBankIdx];
            slotBtn.className = 'btn-candy w-10 h-11 sm:w-11 sm:h-12 rounded-xl bg-blue-600 text-white font-extrabold text-lg sm:text-xl flex items-center justify-center shadow';
            slotBtn.textContent = letterObj.ch;
            slotBtn.addEventListener('click', function () {
              state.spellChosenIndices.splice(i, 1);
              playSound('pop');
              renderSpellingUI();
            });
          } else {
            slotBtn.className = 'w-10 h-11 sm:w-11 sm:h-12 rounded-xl bg-white border-2 border-blue-300 text-blue-300 font-extrabold text-lg flex items-center justify-center';
            slotBtn.textContent = '_';
          }
          slotsContainer.appendChild(slotBtn);
        }

        state.spellShuffledLetters.forEach(function (item, bankIdx) {
          const isUsed = state.spellChosenIndices.includes(bankIdx);
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.disabled = isUsed;
          btn.className = isUsed
            ? 'w-10 h-11 sm:w-11 sm:h-12 rounded-xl bg-slate-200 text-slate-400 font-extrabold text-lg opacity-40 cursor-not-allowed'
            : 'btn-candy w-10 h-11 sm:w-11 sm:h-12 rounded-xl bg-amber-300 hover:bg-amber-200 text-slate-950 font-extrabold text-lg sm:text-xl border-2 border-amber-400';
          btn.textContent = item.ch;

          btn.addEventListener('click', function () {
            if (isUsed || state.spellChosenIndices.length >= target.word.length) return;
            state.spellChosenIndices.push(bankIdx);
            speakEnglish(item.ch.toLowerCase(), 0.95);
            renderSpellingUI();
            checkSpellingCompletion();
          });

          bankContainer.appendChild(btn);
        });
      }

      function checkSpellingCompletion() {
        const target = state.spellCurrentWord;
        if (state.spellChosenIndices.length < target.word.length) return;

        const formed = state.spellChosenIndices.map(function (bIdx) {
          return state.spellShuffledLetters[bIdx].ch;
        }).join('');

        if (formed === target.word) {
          playSound('win');
          speakEnglish(target.word);
          state.streak += 1;
          if (state.streak > state.bestStreak) state.bestStreak = state.streak;
          launchConfetti();
          addStars(15, 'Đánh vần siêu chuẩn: ' + target.word + '!');
          document.getElementById('spellFeedbackBox').innerHTML =
            '🎉 <span class="text-emerald-600">Tuyệt đỉnh! Mía đã ghép đúng từ <strong>' + target.word + '</strong> (' + target.vi + ')!</span>';
        } else {
          playSound('wrong');
          document.getElementById('spellFeedbackBox').innerHTML =
            '🤔 <span class="text-rose-600">Chưa đúng thứ tự rồi! Mía bấm vào chữ trên ô để sửa hoặc bấm "Gợi ý 1 chữ cái" nhé!</span>';
        }
      }

