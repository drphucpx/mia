      function launchConfetti() {
        const canvas = document.getElementById('confettiCanvas');
        if (!canvas) return;
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        const colors = ['#3b82f6', '#f59e0b', '#10b981', '#06b6d4', '#6366f1'];
        confettiPieces = [];
        for (let i = 0; i < 65; i++) {
          confettiPieces.push({
            x: window.innerWidth * 0.5 + (Math.random() - 0.5) * 240,
            y: window.innerHeight * 0.35,
            vx: (Math.random() - 0.5) * 12,
            vy: -Math.random() * 10 - 4,
            size: Math.random() * 8 + 6,
            color: colors[i % colors.length],
            rot: Math.random() * 360,
            vrot: (Math.random() - 0.5) * 12
          });
        }
        if (confettiAnimId) cancelAnimationFrame(confettiAnimId);
        function stepConfetti() {
          const ctx = canvas.getContext('2d');
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          let alive = false;
          for (let i = 0; i < confettiPieces.length; i++) {
            const p = confettiPieces[i];
            p.x += p.vx;
            p.y += p.vy;
            p.vy += 0.35;
            p.rot += p.vrot;
            if (p.y < canvas.height + 20) {
              alive = true;
              ctx.save();
              ctx.translate(p.x, p.y);
              ctx.rotate((p.rot * Math.PI) / 180);
              ctx.fillStyle = p.color;
              ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size);
              ctx.restore();
            }
          }
          if (alive) {
            confettiAnimId = requestAnimationFrame(stepConfetti);
          } else {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            confettiAnimId = null;
          }
        }
        confettiAnimId = requestAnimationFrame(stepConfetti);
      }

      // ---------------------------------------------------------
      // 7. CHESS MOVEMENT & BFS SHORTEST PATH HELPER
      // ---------------------------------------------------------
      function getValidChessMoves(pieceType, pos, boardSize, obstacles) {
        const moves = [];
        const r0 = pos.r;
        const c0 = pos.c;
        const obsSet = new Set((obstacles || []).map(function (o) { return o.r + ',' + o.c; }));

        function inBounds(r, c) {
          return r >= 0 && r < boardSize && c >= 0 && c < boardSize;
        }

        function addSlideMoves(drList, dcList) {
          for (let d = 0; d < drList.length; d++) {
            let nr = r0 + drList[d];
            let nc = c0 + dcList[d];
            while (inBounds(nr, nc)) {
              if (obsSet.has(nr + ',' + nc)) break;
              moves.push({ r: nr, c: nc });
              nr += drList[d];
              nc += dcList[d];
            }
          }
        }

        if (pieceType === 'king') {
          for (let dr = -1; dr <= 1; dr++) {
            for (let dc = -1; dc <= 1; dc++) {
              if (dr === 0 && dc === 0) continue;
              const nr = r0 + dr;
              const nc = c0 + dc;
              if (inBounds(nr, nc) && !obsSet.has(nr + ',' + nc)) {
                moves.push({ r: nr, c: nc });
              }
            }
          }
        } else if (pieceType === 'rook') {
          addSlideMoves([-1, 1, 0, 0], [0, 0, -1, 1]);
        } else if (pieceType === 'bishop') {
          addSlideMoves([-1, -1, 1, 1], [-1, 1, -1, 1]);
        } else if (pieceType === 'queen') {
          addSlideMoves([-1, 1, 0, 0, -1, -1, 1, 1], [0, 0, -1, 1, -1, 1, -1, 1]);
        } else if (pieceType === 'knight') {
          const jumps = [
            [-2, -1], [-2, 1], [-1, -2], [-1, 2],
            [1, -2], [1, 2], [2, -1], [2, 1]
          ];
          jumps.forEach(function (j) {
            const nr = r0 + j[0];
            const nc = c0 + j[1];
            if (inBounds(nr, nc) && !obsSet.has(nr + ',' + nc)) {
              moves.push({ r: nr, c: nc });
            }
          });
        } else if (pieceType === 'pawn') {
          const nr = r0 - 1;
          if (nr >= 0) {
            if (!obsSet.has(nr + ',' + c0)) moves.push({ r: nr, c: c0 });
            if (c0 - 1 >= 0 && !obsSet.has(nr + ',' + (c0 - 1))) moves.push({ r: nr, c: c0 - 1 });
            if (c0 + 1 < boardSize && !obsSet.has(nr + ',' + (c0 + 1))) moves.push({ r: nr, c: c0 + 1 });
          } else {
            moves.push({ r: boardSize - 1, c: c0 });
          }
        }
        return moves;
      }

      // BFS shortest path from start to goal on 6x6 board
      function findShortestChessPath(pieceType, startPos, goalPos, boardSize, obstacles) {
        const queue = [[startPos]];
        const visited = new Set([startPos.r + ',' + startPos.c]);

        while (queue.length > 0) {
          const path = queue.shift();
          const curr = path[path.length - 1];
          if (curr.r === goalPos.r && curr.c === goalPos.c) {
            return path;
          }
          if (path.length > 5) continue;
          const nextMoves = getValidChessMoves(pieceType, curr, boardSize, obstacles);
          for (let i = 0; i < nextMoves.length; i++) {
            const nxt = nextMoves[i];
            const key = nxt.r + ',' + nxt.c;
            if (!visited.has(key)) {
              visited.add(key);
              queue.push(path.concat([nxt]));
            }
          }
        }
        return [startPos, goalPos];
      }

