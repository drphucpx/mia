      function attemptBoardMove(targetR, targetC) {
        if (state.missionCompleted) return;
        const m = BOARD_MISSIONS[state.missionIndex];
        const validMoves = getValidChessMoves(m.pieceType, state.playerPos, 6, m.obstacles);
        const isLegal = validMoves.some(function (mv) { return mv.r === targetR && mv.c === targetC; });

        if (!isLegal) {
          playSound('wrong');
          document.getElementById('canvasFeedbackBar').textContent =
            '⚠️ Ô đó chưa đúng luật đi của ' + m.pieceNameVi + ' (' + m.pieceNameEn + ') rồi! Mía chọn các ô có vòng tròn vàng nhé!';
          return;
        }

        state.playerPos = { r: targetR, c: targetC };
        state.missionSteps += 1;
        state.showHintHighlight = false;
        state.hintPath = [];
        document.getElementById('canvasStepsCount').textContent = 'Số bước: ' + state.missionSteps;

        const starHit = m.stars.find(function (s) { return s.r === targetR && s.c === targetC; });
        if (starHit) {
          const hitWord = getWordById(starHit.wordId);
          speakEnglish(hitWord.word);

          if (starHit.wordId === m.targetWordId) {
            state.missionCompleted = true;
            state.boardWins += 1;
            if (!state.completedLevels.includes(m.level)) {
              state.completedLevels.push(m.level);
            }
            state.streak += 1;
            if (state.streak > state.bestStreak) state.bestStreak = state.streak;
            spawnBoardParticles(targetR, targetC, '#10b981');
            playSound('win');
            launchConfetti();
            addStars(15, 'Chiến thắng Màn ' + m.level + ': ' + hitWord.word + '!');
            renderLevelSelectorBar();
            document.getElementById('canvasFeedbackBar').textContent =
              '🏆 Quá siêu! "' + hitWord.word + '" chính là "' + hitWord.vi + '"! Bấm "Màn tiếp" để chinh phục tiếp nhé!';
          } else {
            spawnBoardParticles(targetR, targetC, '#f59e0b');
            playSound('wrong');
            document.getElementById('canvasFeedbackBar').textContent =
              '💡 Ngôi sao này là "' + hitWord.word + '" (' + hitWord.vi + '). Mía hãy đi tiếp tới ngôi sao "' + getWordById(m.targetWordId).vi + '" nhé!';
          }
        } else {
          spawnBoardParticles(targetR, targetC, '#3b82f6');
          playSound('move');
          speakEnglish(m.pieceNameEn);
          document.getElementById('canvasFeedbackBar').textContent =
            '⚡ Nước đi chuẩn lắm! Mía tiếp tục điều khiển ' + m.pieceNameEn + ' về phía ngôi sao mục tiêu nào!';
        }

        renderValidMoveButtons();
      }

      function resizeAndDrawBoardCanvas() {
        const container = document.getElementById('chessCanvasContainer');
        const canvas = document.getElementById('adventureChessCanvas');
        if (!container || !canvas) return;
        const rect = container.getBoundingClientRect();
        const size = Math.max(260, Math.floor(rect.width));
        if (canvas.width !== size || canvas.height !== size) {
          canvas.width = size;
          canvas.height = size;
        }
        drawAdventureBoard();
      }

      function drawAdventureBoard() {
        const canvas = document.getElementById('adventureChessCanvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        const W = canvas.width;
        const H = canvas.height;
        const N = 6;
        const cell = W / N;

        // Smooth interpolation of piece position
        state.renderPos.r += (state.playerPos.r - state.renderPos.r) * 0.28;
        state.renderPos.c += (state.playerPos.c - state.renderPos.c) * 0.28;

        ctx.clearRect(0, 0, W, H);

        const m = BOARD_MISSIONS[state.missionIndex];
        const validMoves = getValidChessMoves(m.pieceType, state.playerPos, N, m.obstacles);
        const validSet = new Set(validMoves.map(function (mv) { return mv.r + ',' + mv.c; }));
        const colNames = ['A', 'B', 'C', 'D', 'E', 'F'];

        // Draw 6x6 squares (Royal Blue & Sky White theme)
        for (let r = 0; r < N; r++) {
          for (let c = 0; c < N; c++) {
            const x = c * cell;
            const y = r * cell;
            const isLight = (r + c) % 2 === 0;
            const isHovered = state.hoverCell && state.hoverCell.r === r && state.hoverCell.c === c;

            ctx.fillStyle = isHovered
              ? '#fde68a'
              : (isLight ? '#f0f9ff' : '#93c5fd');
            ctx.fillRect(x, y, cell, cell);

            // Coordinate label
            if (r === N - 1) {
              ctx.fillStyle = isLight ? '#1e40af' : '#0f172a';
              ctx.font = 'bold ' + Math.max(10, Math.floor(cell * 0.16)) + 'px Nunito, sans-serif';
              ctx.textAlign = 'right';
              ctx.fillText(colNames[c], x + cell - 4, y + cell - 4);
            }
            if (c === 0) {
              ctx.fillStyle = isLight ? '#1e40af' : '#0f172a';
              ctx.font = 'bold ' + Math.max(10, Math.floor(cell * 0.16)) + 'px Nunito, sans-serif';
              ctx.textAlign = 'left';
              ctx.fillText(String(N - r), x + 4, y + Math.floor(cell * 0.22));
            }

            // Highlight valid moves with pulsing golden ring
            if (!state.missionCompleted && validSet.has(r + ',' + c)) {
              const pulse = 0.82 + 0.18 * Math.sin(boardPulsePhase * 4);
              ctx.save();
              ctx.strokeStyle = 'rgba(245, 158, 11, 0.95)';
              ctx.fillStyle = 'rgba(254, 243, 199, 0.6)';
              ctx.lineWidth = 3;
              ctx.beginPath();
              ctx.arc(x + cell / 2, y + cell / 2, cell * 0.34 * pulse, 0, Math.PI * 2);
              ctx.fill();
              ctx.stroke();
              ctx.restore();
            }
          }
        }

        // Draw shortest path hint line if active
        if (state.showHintHighlight && state.hintPath.length > 1) {
          ctx.save();
          ctx.strokeStyle = '#10b981';
          ctx.lineWidth = 5;
          ctx.setLineDash([8, 6]);
          ctx.beginPath();
          state.hintPath.forEach(function (pt, idx) {
            const hx = pt.c * cell + cell / 2;
            const hy = pt.r * cell + cell / 2;
            if (idx === 0) ctx.moveTo(hx, hy);
            else ctx.lineTo(hx, hy);
          });
          ctx.stroke();
          ctx.restore();
        }

        // Draw hover trajectory line if hovering over a valid square
        if (!state.missionCompleted && state.hoverCell && validSet.has(state.hoverCell.r + ',' + state.hoverCell.c)) {
          ctx.save();
          ctx.strokeStyle = 'rgba(37, 99, 235, 0.65)';
          ctx.lineWidth = 4;
          ctx.beginPath();
          ctx.moveTo(state.renderPos.c * cell + cell / 2, state.renderPos.r * cell + cell / 2);
          ctx.lineTo(state.hoverCell.c * cell + cell / 2, state.hoverCell.r * cell + cell / 2);
          ctx.stroke();
          ctx.restore();
        }

        // Draw obstacles
        m.obstacles.forEach(function (obs) {
          const cx = obs.c * cell + cell / 2;
          const cy = obs.r * cell + cell / 2;
          ctx.font = Math.floor(cell * 0.5) + 'px serif';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText('🪨', cx, cy);
        });

        // Draw stars with English vocabulary labels
        m.stars.forEach(function (st) {
          if (state.missionCompleted && st.wordId === m.targetWordId &&
              state.playerPos.r === st.r && state.playerPos.c === st.c) {
            return;
          }
          const wordObj = getWordById(st.wordId);
          const cx = st.c * cell + cell / 2;
          const cy = st.r * cell + cell / 2;

          if (state.showHintHighlight && st.wordId === m.targetWordId) {
            ctx.save();
            ctx.strokeStyle = '#10b981';
            ctx.lineWidth = 4;
            ctx.strokeRect(st.c * cell + 3, st.r * cell + 3, cell - 6, cell - 6);
            ctx.restore();
          }

          ctx.font = Math.floor(cell * 0.42) + 'px serif';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText('⭐', cx, cy - cell * 0.1);

          const pillW = cell * 0.92;
          const pillH = Math.max(16, cell * 0.28);
          const px = cx - pillW / 2;
          const py = cy + cell * 0.14;

          ctx.fillStyle = '#0f172a';
          ctx.beginPath();
          ctx.roundRect(px, py, pillW, pillH, 6);
          ctx.fill();

          ctx.fillStyle = '#fde047';
          ctx.font = '800 ' + Math.max(9, Math.floor(cell * 0.17)) + 'px Nunito, sans-serif';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText(wordObj.word, cx, py + pillH / 2 + 1);
        });

        // Draw particle effects on canvas
        for (let i = state.canvasParticles.length - 1; i >= 0; i--) {
          const pt = state.canvasParticles[i];
          pt.r += pt.vr;
          pt.c += pt.vc;
          pt.alpha -= 0.04;
          if (pt.alpha <= 0) {
            state.canvasParticles.splice(i, 1);
            continue;
          }
          ctx.save();
          ctx.globalAlpha = pt.alpha;
          ctx.fillStyle = pt.color;
          ctx.beginPath();
          ctx.arc(pt.c * cell, pt.r * cell, 5, 0, Math.PI * 2);
          ctx.fill();
          ctx.restore();
        }

        // Draw Player Piece with smooth interpolated position & bounce
        const px = state.renderPos.c * cell + cell / 2;
        const py = state.renderPos.r * cell + cell / 2 + Math.sin(boardPulsePhase * 5) * 2.5;

        ctx.save();
        ctx.fillStyle = '#ffffff';
        ctx.strokeStyle = '#2563eb';
        ctx.lineWidth = 4;
        ctx.beginPath();
        ctx.arc(px, py, cell * 0.38, 0, Math.PI * 2);
        ctx.fill();
        ctx.stroke();

        ctx.font = Math.floor(cell * 0.52) + 'px serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(m.pieceEmoji, px, py + 2);
        ctx.restore();
      }

      function startBoardAnimationLoop() {
        if (boardAnimId) cancelAnimationFrame(boardAnimId);
        function loop() {
          boardPulsePhase += 0.025;
          if (state.activeTab === 'board' || state.allInOneView) {
            drawAdventureBoard();
          }
          boardAnimId = requestAnimationFrame(loop);
        }
        boardAnimId = requestAnimationFrame(loop);
      }

