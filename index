        if (!container) return;
        container.innerHTML = '';

        const m = BOARD_MISSIONS[state.missionIndex];
        const validMoves = getValidChessMoves(m.pieceType, state.playerPos, 6, m.obstacles);
        const colNames = ['A', 'B', 'C', 'D', 'E', 'F'];

        if (state.missionCompleted) {
          const doneBtn = document.createElement('button');
          doneBtn.type = 'button';
          doneBtn.className = 'btn-candy bg-emerald-500 hover:bg-emerald-400 text-white font-extrabold text-xs sm:text-sm px-4 py-2 rounded-xl';
          doneBtn.textContent = '🎉 Qua màn tiếp theo ➡️';
