      // 11. TAB 4: MEMORY MATCH GAME + PEEK POWER-UP
      // ---------------------------------------------------------
      function initMemoryGame(pairCount) {
        if (typeof pairCount === 'number') state.memoryPairsCount = pairCount;
        state.memoryFlippedIndices = [];
        state.memoryMatchedIds = [];
        state.memoryMoves = 0;
        state.memoryLocked = false;
        state.memoryPeekUsed = false;

        const peekBtn = document.getElementById('peekMemoryBtn');
        if (peekBtn) {
          peekBtn.disabled = false;
          peekBtn.className = 'btn-candy bg-amber-400 hover:bg-amber-300 text-slate-950 font-extrabold text-xs px-3 py-2 rounded-xl flex items-center gap-1';
        }

        const pool = CHESS_WORDS.slice().sort(function () { return Math.random() - 0.5; });
        const chosen = pool.slice(0, state.memoryPairsCount);

        const deck = [];
        chosen.forEach(function (w) {
          deck.push({
            wordId: w.id,
            cardType: 'en',
            word: w.word,
            phonetic: w.phonetic,
            emoji: w.emoji,
            vi: w.vi
          });
          deck.push({
            wordId: w.id,
            cardType: 'vi',
            word: w.word,
            phonetic: w.phonetic,
            emoji: w.emoji,
            vi: w.vi
          });
        });

        deck.sort(function () { return Math.random() - 0.5; });
        state.memoryCards = deck;

        updateMemoryStatsUI();
        renderMemoryGrid();
      }

      function updateMemoryStatsUI() {
        document.getElementById('memoryPairsText').textContent =
          '🎯 Đã ghép: ' + state.memoryMatchedIds.length + ' / ' + state.memoryPairsCount + ' cặp';
        document.getElementById('memoryMovesText').textContent =
          '👆 Số lần lật: ' + state.memoryMoves;
      }

      function renderMemoryGrid() {
        const grid = document.getElementById('memoryBoardGrid');
        if (!grid) return;
        grid.innerHTML = '';

        state.memoryCards.forEach(function (card, idx) {
          const isFlipped = state.memoryFlippedIndices.includes(idx) || state.memoryMatchedIds.includes(card.wordId);
          const isMatched = state.memoryMatchedIds.includes(card.wordId);

          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'btn-candy h-28 sm:h-32 rounded-2xl p-3 flex flex-col items-center justify-center text-center transition-all border-4 ' +
            (isMatched
              ? 'bg-emerald-100 border-emerald-400 text-emerald-950 scale-95'
              : isFlipped
                ? 'bg-white border-amber-400 text-slate-900'
                : 'bg-gradient-to-br from-blue-600 to-indigo-800 border-blue-400 text-white hover:scale-[1.02]');

          if (!isFlipped) {
            btn.innerHTML = '<span class="text-3xl sm:text-4xl">🛡️</span><span class="text-xs font-extrabold mt-1 opacity-90">Thẻ của Mía</span>';
          } else if (card.cardType === 'en') {
            btn.innerHTML =
              '<span class="text-xs font-bold text-blue-600 uppercase">Tiếng Anh 🔊</span>' +
              '<span class="text-lg sm:text-xl font-extrabold text-slate-900 mt-0.5">' + card.word + '</span>' +
              '<span class="text-xs font-semibold text-slate-500">' + card.phonetic + '</span>';
          } else {
            btn.innerHTML =
              '<span class="text-3xl sm:text-4xl">' + card.emoji + '</span>' +
              '<span class="text-sm sm:text-base font-extrabold text-indigo-900 mt-1">' + card.vi + '</span>';
          }

          btn.addEventListener('click', function () {
            onMemoryCardClick(idx);
          });

          grid.appendChild(btn);
        });
      }

      function onMemoryCardClick(idx) {
        if (state.memoryLocked) return;
        const card = state.memoryCards[idx];
        if (!card) return;
        if (state.memoryFlippedIndices.includes(idx) || state.memoryMatchedIds.includes(card.wordId)) return;

        speakEnglish(card.word);
        state.memoryFlippedIndices.push(idx);
        renderMemoryGrid();

        if (state.memoryFlippedIndices.length === 2) {
          state.memoryMoves += 1;
          const idx1 = state.memoryFlippedIndices[0];
          const idx2 = state.memoryFlippedIndices[1];
          const c1 = state.memoryCards[idx1];
          const c2 = state.memoryCards[idx2];

          if (c1.wordId === c2.wordId) {
            state.memoryMatchedIds.push(c1.wordId);
            state.memoryFlippedIndices = [];
            playSound('win');
            addStars(5, 'Ghép đúng cặp: ' + c1.word + '!');
            document.getElementById('memoryStatusText').textContent =
              '🎉 Tuyệt vời! ' + c1.word + ' = ' + c1.vi + '!';
            updateMemoryStatsUI();
            renderMemoryGrid();

            if (state.memoryMatchedIds.length === state.memoryPairsCount) {
              launchConfetti();
              addStars(20, 'Mía chiến thắng ván Lật Thẻ Trí Nhớ!');
              document.getElementById('memoryStatusText').textContent =
                '🏆 Chúc mừng Mía đã lật mở hết tất cả các cặp thẻ!';
            }
          } else {
            state.memoryLocked = true;
            document.getElementById('memoryStatusText').textContent =
              '🤔 Chưa trùng nhau rồi, Mía nhớ vị trí thẻ nhé!';
            updateMemoryStatsUI();
            setTimeout(function () {
              state.memoryFlippedIndices = [];
              state.memoryLocked = false;
              renderMemoryGrid();
            }, 850);
          }
        }
      }

      // ---------------------------------------------------------
      // 12. BADGES MODAL RENDERER
      // ---------------------------------------------------------
      function renderBadgesModal() {
        const container = document.getElementById('badgesGridContainer');
        if (!container) return;
        container.innerHTML = '';

        BADGES_CONFIG.forEach(function (b) {
          const unlocked = b.check(state);
          const card = document.createElement('div');
          card.className = 'p-3.5 rounded-2xl border-2 flex items-start gap-3 ' +
            (unlocked
              ? 'bg-gradient-to-br from-amber-50 to-blue-50 border-amber-400'
              : 'bg-slate-50 border-slate-200 opacity-60');

          const icon = document.createElement('div');
          icon.className = 'text-3xl shrink-0';
          icon.textContent = unlocked ? b.icon : '🔒';

          const info = document.createElement('div');
          const title = document.createElement('div');
          title.className = 'font-extrabold text-sm text-slate-900';
          title.textContent = b.title;
          const desc = document.createElement('div');
          desc.className = 'text-xs font-semibold text-slate-600 mt-0.5';
          desc.textContent = b.desc;

          info.appendChild(title);
          info.appendChild(desc);
          card.appendChild(icon);
          card.appendChild(info);
          container.appendChild(card);
        });
      }

      // ---------------------------------------------------------
      // 13. NAVIGATION, KEYBOARD SHORTCUTS & EVENT LISTENERS
      // ---------------------------------------------------------
      function switchTab(tabId) {
        state.activeTab = tabId;
        playSound('pop');

        document.querySelectorAll('.tab-panel').forEach(function (panel) {
          panel.classList.add('hidden');
        });
        const activePanel = document.getElementById('tab-' + tabId);
        if (activePanel) {
          activePanel.classList.remove('hidden');
          if (state.allInOneView) {
            activePanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }

        document.querySelectorAll('.nav-tab-btn').forEach(function (btn) {
          const t = btn.getAttribute('data-tab');
          if (t === tabId) {
            btn.className = 'nav-tab-btn btn-candy bg-amber-400 text-slate-950 font-extrabold text-xs sm:text-sm px-3 sm:px-4 py-2 rounded-xl flex items-center gap-1.5 shrink-0';
          } else {
            btn.className = 'nav-tab-btn btn-candy bg-blue-800/80 hover:bg-blue-700 text-white font-bold text-xs sm:text-sm px-3 sm:px-4 py-2 rounded-xl flex items-center gap-1.5 shrink-0';
          }
        });

        if (tabId === 'board') {
          setTimeout(resizeAndDrawBoardCanvas, 40);
        } else if (tabId === 'quiz' && state.quizSubmode === 'mc') {
          startQuizSpeedBar();
        }
      }

      function attachEvents() {
        // Navigation tabs
        document.querySelectorAll('.nav-tab-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            switchTab(btn.getAttribute('data-tab'));
          });
        });

        // All-in-one single page toggle & standalone HTML download
        document.getElementById('toggleAllInOneViewBtn').addEventListener('click', function () {
          state.allInOneView = !state.allInOneView;
          document.body.classList.toggle('all-in-one-active', state.allInOneView);
          document.getElementById('allInOneViewLabel').textContent = state.allInOneView
            ? 'Chế độ: Tất cả trên 1 trang ✅'
            : 'Xem tất cả trên 1 trang';
          playSound('pop');
          setTimeout(resizeAndDrawBoardCanvas, 50);
          showToast('📜',
            state.allInOneView ? 'Đã mở toàn bộ 4 trò chơi trên 1 trang!' : 'Đã chuyển về chế độ xem theo từng Tab!',
            'Tất cả dữ liệu đều gói gọn trong 1 file HTML duy nhất.');
        });

        document.getElementById('downloadSingleHtmlBtn').addEventListener('click', function () {
          playSound('win');
          const htmlContent = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
          const blob = new Blob([htmlContent], { type: 'text/html;charset=utf-8' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = 'mia_chess_english_game.html';
          document.body.appendChild(a);
          a.click();
          document.body.removeChild(a);
          setTimeout(function () { URL.revokeObjectURL(url); }, 1500);
          showToast('💾', 'Đã tải file mia_chess_english_game.html!', 'Toàn bộ hình ảnh, âm thanh và 4 trò chơi nằm gọn trong 1 file HTML!');
        });

        // Header buttons
        document.getElementById('speakWelcomeBtn').addEventListener('click', function () {
          speakEnglish('Hello Prince Mia! Welcome to your Magical Chess Kingdom! Let us conquer all chess words together!');
          showToast('👑', 'Hello Prince Mía!', 'Chúc Hoàng tử Mía chinh phục cờ vua thật ngầu nhé!');
        });

        document.getElementById('toggleSpeedBtn').addEventListener('click', function () {
          state.slowSpeech = !state.slowSpeech;
          document.getElementById('speedIcon').textContent = state.slowSpeech ? '🐢' : '🐇';
          document.getElementById('speedText').textContent = state.slowSpeech ? 'Đọc chậm' : 'Đọc vừa';
          showToast(state.slowSpeech ? '🐢' : '🐇',
            state.slowSpeech ? 'Đã bật chế độ Đọc Chậm' : 'Đã bật chế độ Đọc Tự Nhiên',
            'Giúp Mía nghe phát âm chuẩn xác hơn!');
        });

        document.getElementById('toggleMuteBtn').addEventListener('click', function () {
          state.muted = !state.muted;
          document.getElementById('muteIcon').textContent = state.muted ? '🔇' : '🔊';
        });

        // Badges Modal
        document.getElementById('openBadgesBtn').addEventListener('click', function () {
          renderBadgesModal();
          document.getElementById('badgesModal').classList.remove('hidden');
          playSound('pop');
        });
        document.getElementById('closeBadgesBtn').addEventListener('click', function () {
          document.getElementById('badgesModal').classList.add('hidden');
        });
        document.getElementById('closeBadgesBottomBtn').addEventListener('click', function () {
          document.getElementById('badgesModal').classList.add('hidden');
        });

        // Tab 1: Category Filter & Flashcard buttons
        document.querySelectorAll('.cat-filter-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            state.currentCategory = btn.getAttribute('data-cat');
            state.currentWordIndex = 0;
            updateCategoryButtonsUI();
            renderFlashcard();
            playSound('pop');
          });
        });

        document.getElementById('randomWordBtn').addEventListener('click', function () {
          const list = getFilteredWords();
          state.currentWordIndex = Math.floor(Math.random() * list.length);
          const w = getCurrentWordObj();
          speakEnglish(w.word);
          renderFlashcard();
        });

        document.getElementById('cardArtContainer').addEventListener('click', function () {
          speakEnglish(getCurrentWordObj().word);
        });

        document.getElementById('speakWordMainBtn').addEventListener('click', function () {
          speakEnglish(getCurrentWordObj().word);
        });

        document.getElementById('speakSentenceBtn').addEventListener('click', function () {
          speakEnglish(getCurrentWordObj().exampleEn);
        });

        document.getElementById('spellFullWordBtn').addEventListener('click', function () {
          const w = getCurrentWordObj();
          const spelled = w.word.split('').join('. ') + '. ' + w.word + '!';
          speakEnglish(spelled, 0.8);
        });

        document.getElementById('prevWordBtn').addEventListener('click', function () {
          state.currentWordIndex -= 1;
          const w = getCurrentWordObj();
          speakEnglish(w.word);
          renderFlashcard();
        });

        document.getElementById('nextWordBtn').addEventListener('click', function () {
          state.currentWordIndex += 1;
          const w = getCurrentWordObj();
          speakEnglish(w.word);
          renderFlashcard();
        });

        document.getElementById('toggleMasteredBtn').addEventListener('click', function () {
          const w = getCurrentWordObj();
          const idx = state.masteredIds.indexOf(w.id);
          if (idx === -1) {
            state.masteredIds.push(w.id);
            playSound('win');
            addStars(5, 'Mía đã thuộc từ ' + w.word + '!');
          } else {
            state.masteredIds.splice(idx, 1);
            saveState();
            updateHeaderStats();
          }
          renderFlashcard();
        });

        document.getElementById('resetMiniBoardBtn').addEventListener('click', function () {
          state.miniBoardPos = { r: 2, c: 2 };
          spawnMiniStar(state.miniBoardPos);
          playSound('pop');
          renderMiniChessboard();
        });

        // Tab 2: <canvas> Adventure Board clicks, hover & buttons
        const boardCanvas = document.getElementById('adventureChessCanvas');
        boardCanvas.addEventListener('mousemove', function (ev) {
          const rect = boardCanvas.getBoundingClientRect();
          const x = ev.clientX - rect.left;
          const y = ev.clientY - rect.top;
          const c = Math.floor((x / rect.width) * 6);
          const r = Math.floor((y / rect.height) * 6);
          if (r >= 0 && r < 6 && c >= 0 && c < 6) {
            state.hoverCell = { r: r, c: c };
          } else {
            state.hoverCell = null;
          }
        });
        boardCanvas.addEventListener('mouseleave', function () {
          state.hoverCell = null;
        });
        boardCanvas.addEventListener('click', function (ev) {
          const rect = boardCanvas.getBoundingClientRect();
          const x = ev.clientX - rect.left;
          const y = ev.clientY - rect.top;
          const c = Math.floor((x / rect.width) * 6);
          const r = Math.floor((y / rect.height) * 6);
          if (r >= 0 && r < 6 && c >= 0 && c < 6) {
            attemptBoardMove(r, c);
          }
        });

        document.getElementById('speakMissionTargetBtn').addEventListener('click', function () {
          const m = BOARD_MISSIONS[state.missionIndex];
          const targetWord = getWordById(m.targetWordId);
          speakEnglish(targetWord.word);
        });

        document.getElementById('boardHintBtn').addEventListener('click', function () {
          state.showHintHighlight = true;
          const m = BOARD_MISSIONS[state.missionIndex];
          const targetWord = getWordById(m.targetWordId);
          const targetStar = m.stars.find(function (s) { return s.wordId === m.targetWordId; });
          if (targetStar) {
            state.hintPath = findShortestChessPath(m.pieceType, state.playerPos, targetStar, 6, m.obstacles);
          }
          speakEnglish(targetWord.word);
          document.getElementById('canvasFeedbackBar').textContent =
            '💡 Rada dẫn đường đã bật! Từ tiếng Anh của "' + targetWord.vi + '" là "' + targetWord.word + '" (đường kẻ xanh lá trên bàn cờ)!';
        });

        document.getElementById('resetMissionBtn').addEventListener('click', function () {
          loadMission(state.missionIndex);
          playSound('pop');
        });

        document.getElementById('nextMissionBtn').addEventListener('click', function () {
          loadMission(state.missionIndex + 1);
          playSound('pop');
        });

        // Tab 3: Quiz & Spelling controls
        document.getElementById('submodeQuizBtn').addEventListener('click', function () {
          state.quizSubmode = 'mc';
          document.getElementById('quizMultipleChoiceBox').classList.remove('hidden');
          document.getElementById('quizSpellingBox').classList.add('hidden');
          document.getElementById('submodeQuizBtn').className = 'btn-candy bg-blue-600 text-white font-extrabold text-xs sm:text-sm px-4 py-2 rounded-xl flex items-center gap-1.5';
          document.getElementById('submodeSpellBtn').className = 'btn-candy bg-slate-100 text-slate-900 font-bold text-xs sm:text-sm px-4 py-2 rounded-xl flex items-center gap-1.5';
          playSound('pop');
          startQuizSpeedBar();
        });

        document.getElementById('submodeSpellBtn').addEventListener('click', function () {
          state.quizSubmode = 'spell';
          document.getElementById('quizMultipleChoiceBox').classList.add('hidden');
          document.getElementById('quizSpellingBox').classList.remove('hidden');
          document.getElementById('submodeSpellBtn').className = 'btn-candy bg-blue-600 text-white font-extrabold text-xs sm:text-sm px-4 py-2 rounded-xl flex items-center gap-1.5';
          document.getElementById('submodeQuizBtn').className = 'btn-candy bg-slate-100 text-slate-900 font-bold text-xs sm:text-sm px-4 py-2 rounded-xl flex items-center gap-1.5';
          playSound('pop');
        });

        document.getElementById('toggleAutoSpeakQuizBtn').addEventListener('click', function () {
          state.autoSpeakQuiz = !state.autoSpeakQuiz;
          document.getElementById('toggleAutoSpeakQuizBtn').textContent =
            state.autoSpeakQuiz ? '🔊 Tự đọc câu hỏi: BẬT' : '🔇 Tự đọc câu hỏi: TẮT';
        });

        document.getElementById('newQuizRoundBtn').addEventListener('click', function () {
          if (state.quizSubmode === 'mc') {
            state.quizQuestionIndex = 0;
            state.quizRoundScore = 0;
            generateQuizQuestion();
          } else {
            startNewSpellingWord();
          }
          playSound('pop');
        });

        document.getElementById('quizSpeakPromptBtn').addEventListener('click', function () {
          if (state.quizCurrentWord) speakEnglish(state.quizCurrentWord.word);
        });

        document.getElementById('quizNextBtn').addEventListener('click', function () {
          state.quizQuestionIndex = (state.quizQuestionIndex + 1) % 10;
          if (state.quizQuestionIndex === 0) {
            launchConfetti();
            showToast('🏆', 'Hoàn thành 10 câu đố!', 'Mía đạt ' + state.quizRoundScore + '/10 câu đúng!');
            state.quizRoundScore = 0;
          }
          generateQuizQuestion();
        });

        document.getElementById('spellListenBtn').addEventListener('click', function () {
          if (state.spellCurrentWord) speakEnglish(state.spellCurrentWord.word);
        });

        document.getElementById('spellHintLetterBtn').addEventListener('click', function () {
          const target = state.spellCurrentWord;
          if (!target) return;
          const nextPos = state.spellChosenIndices.length;
          if (nextPos >= target.word.length) return;
          const neededChar = target.word[nextPos];
          const bankIdx = state.spellShuffledLetters.findIndex(function (item, idx) {
            return item.ch === neededChar && !state.spellChosenIndices.includes(idx);
          });
          if (bankIdx !== -1) {
            state.spellChosenIndices.push(bankIdx);
            speakEnglish(neededChar.toLowerCase(), 0.9);
            renderSpellingUI();
            checkSpellingCompletion();
          }
        });

        document.getElementById('spellClearBtn').addEventListener('click', function () {
          state.spellChosenIndices = [];
          playSound('pop');
          renderSpellingUI();
        });

        document.getElementById('spellNextWordBtn').addEventListener('click', function () {
          startNewSpellingWord();
          playSound('pop');
        });

        // Tab 4: Memory Match controls + Peek Powerup
        document.getElementById('peekMemoryBtn').addEventListener('click', function () {
          if (state.memoryPeekUsed || state.memoryLocked) return;
          state.memoryPeekUsed = true;
          state.memoryLocked = true;
          const peekBtn = document.getElementById('peekMemoryBtn');
          peekBtn.disabled = true;
          peekBtn.className = 'bg-slate-200 text-slate-400 font-bold text-xs px-3 py-2 rounded-xl cursor-not-allowed flex items-center gap-1';

          const allIndices = state.memoryCards.map(function (_, i) { return i; });
          state.memoryFlippedIndices = allIndices;
          playSound('win');
          document.getElementById('memoryStatusText').textContent = '👁️ Mắt Thần đang mở toàn bộ thẻ trong 2 giây! Mía nhìn nhanh nhé!';
          renderMemoryGrid();

          setTimeout(function () {
            state.memoryFlippedIndices = [];
            state.memoryLocked = false;
            document.getElementById('memoryStatusText').textContent = '⚡ Hết 2 giây! Bây giờ Mía hãy lật ghép các cặp thẻ nhé!';
            renderMemoryGrid();
          }, 2000);
        });

        document.querySelectorAll('.mem-diff-btn').forEach(function (btn) {
          btn.addEventListener('click', function () {
            const pairs = parseInt(btn.getAttribute('data-memdiff'), 10);
            document.querySelectorAll('.mem-diff-btn').forEach(function (b) {
              b.className = 'mem-diff-btn btn-candy bg-slate-100 text-slate-900 font-bold text-xs px-3 py-2 rounded-xl';
            });
            btn.className = 'mem-diff-btn btn-candy bg-emerald-500 text-white font-extrabold text-xs px-3 py-2 rounded-xl';
            initMemoryGame(pairs);
            playSound('pop');
          });
        });

        document.getElementById('restartMemoryBtn').addEventListener('click', function () {
          initMemoryGame(state.memoryPairsCount);
          playSound('pop');
        });

        // Global Keyboard Shortcuts for smooth optimized play
        window.addEventListener('keydown', function (ev) {
          if (ev.target && (ev.target.tagName === 'INPUT' || ev.target.tagName === 'TEXTAREA')) return;

          if (state.activeTab === 'learn') {
            if (ev.key === 'ArrowRight') {
              ev.preventDefault();
              document.getElementById('nextWordBtn').click();
            } else if (ev.key === 'ArrowLeft') {
              ev.preventDefault();
              document.getElementById('prevWordBtn').click();
            } else if (ev.key === ' ') {
              ev.preventDefault();
              speakEnglish(getCurrentWordObj().word);
            }
          } else if (state.activeTab === 'quiz') {
            if (state.quizSubmode === 'mc') {
              if (['1', '2', '3', '4'].includes(ev.key) && !state.quizAnswered) {
                const idx = parseInt(ev.key, 10) - 1;
                const optBtn = document.querySelector('[data-quiz-opt-idx="' + idx + '"]');
                if (optBtn) optBtn.click();
              } else if (ev.key === 'Enter' && state.quizAnswered) {
                document.getElementById('quizNextBtn').click();
              }
            } else if (state.quizSubmode === 'spell') {
              const target = state.spellCurrentWord;
              if (!target) return;
              if (ev.key === 'Backspace') {
                ev.preventDefault();
                if (state.spellChosenIndices.length > 0) {
                  state.spellChosenIndices.pop();
                  playSound('pop');
                  renderSpellingUI();
                }
              } else if (/^[a-zA-Z]$/.test(ev.key)) {
                const upper = ev.key.toUpperCase();
                const bankIdx = state.spellShuffledLetters.findIndex(function (item, idx) {
                  return item.ch === upper && !state.spellChosenIndices.includes(idx);
                });
                if (bankIdx !== -1 && state.spellChosenIndices.length < target.word.length) {
                  state.spellChosenIndices.push(bankIdx);
                  speakEnglish(upper.toLowerCase(), 0.95);
                  renderSpellingUI();
                  checkSpellingCompletion();
                }
              }
            }
          }
        });

        window.addEventListener('resize', function () {
          resizeAndDrawBoardCanvas();
        });
      }

      // ---------------------------------------------------------
      // 14. INITIALIZE ON WINDOW.ONLOAD
      // ---------------------------------------------------------
      window.onload = function () {
        document.body.classList.add('all-in-one-active');
        document.getElementById('allInOneViewLabel').textContent = 'Chế độ: Tất cả trên 1 trang ✅';
        loadSavedState();
        updateHeaderStats();
        spawnMiniStar(state.miniBoardPos);
        renderFlashcard();
        loadMission(0);
        generateQuizQuestion();
        startNewSpellingWord();
        initMemoryGame(4);
        attachEvents();
        startBoardAnimationLoop();
      };
    })();
  </script>

