              ? 'bg-amber-400 hover:bg-amber-300 text-slate-950 border-amber-500'
              : 'bg-blue-50 hover:bg-blue-100 text-blue-950 border-blue-200');
          btn.textContent = starWord
            ? '⭐ Ô ' + coordLabel + ' (' + starWord.word + ')'
